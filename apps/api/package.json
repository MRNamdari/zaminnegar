{
  "name": "@zaminnegar/api",
  "version": "1.0.0",
  "private": true,
  "description": "Zaminnegar REST API (NestJS, CQRS, TypeORM, PostGIS).",
  "scripts": {
    "build": "nest build api",
    "start": "nest start api",
    "start:dev": "nest start api --watch",
    "start:prod": "node dist/main.js",
    "openapi:generate": "nest start openapi",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "node scripts/migration-generate.js",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --require ts-node/register --test \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "@casl/ability": "^7.1.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.10",
    "@nestjs/axios": "^12.0.2",
    "@nestjs/common": "^12.6.3",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.3",
    "@nestjs/cqrs": "^12.1.3",
    "@nestjs/platform-fastify": "^12.6.3",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.3",
    "@nestjs/typeorm": "^12.0.3",
    "@nestjs/workflows": "^0.0.5",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^18.0.10",
    "fastify": "5.12.8",
    "pg": "^8.23.1",
    "proper-lockfile": "^4.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.17",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "ts-node": "^10.9.2",
    "typescript": "catalog:"
  }
}
