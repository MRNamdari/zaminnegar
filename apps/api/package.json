{
  "name": "@zaminnegar/api",
  "version": "1.0.0",
  "private": true,
  "description": "Zaminnegar REST API (NestJS, CQRS, TypeORM, PostGIS).",
  "scripts": {
    "build": "nest build api",
    "start": "nest start api",
    "start:dev": "nest start api --watch",
    "start:prod": "node dist/main.js",
    "openapi:generate": "nest start openapi",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "node scripts/migration-generate.js",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@casl/ability": "^7.1.2",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "catalog:"
  }
}
