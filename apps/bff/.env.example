# Origin of @zaminnegar/api (server-side only; never exposed to the browser).
API_BASE_URL=http://localhost:3001

# Satellite imagery: esri (default, no key) | mapbox | maptiler
MAP_IMAGERY_PROVIDER=esri
MAPBOX_TOKEN=
MAPTILER_KEY=
# Initial map view as "longitude,latitude" and zoom.
MAP_DEFAULT_CENTER=49.6,37.3
MAP_DEFAULT_ZOOM=10

# Place search (Nominatim policy: identify yourself, max ~1 request/second).
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=zaminnegar-bff/1.0 (you@example.com)
