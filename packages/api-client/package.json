{
  "name": "@zaminnegar/api-client",
  "version": "1.0.1",
  "private": true,
  "description": "Type-safe HTTP client generated from the @zaminnegar/api OpenAPI document.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json --output ./src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.1"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:"
  }
}
