{
  "name": "@zaminnegar/api-client",
  "version": "1.0.4",
  "private": true,
  "description": "Type-safe API client generated from the @zaminnegar/api OpenAPI document.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "typed-openapi",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "typed-openapi": "^4.1.0",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
