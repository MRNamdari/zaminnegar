{
  "name": "zaminnegar",
  "version": "1.0.0",
  "description": "Farmland management and GIS application.",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @zaminnegar/api start:dev",
    "dev:bff": "pnpm --filter @zaminnegar/bff dev",
    "build:api": "pnpm --filter @zaminnegar/api build",
    "build:bff": "pnpm --filter @zaminnegar/bff build",
    "dev": "pnpm run '/^dev:.*/'",
    "build": "pnpm -r build",
    "update": "pnpm -r update --workspace",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module"
}
